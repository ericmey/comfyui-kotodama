# Copy to .env next to this file. .env is gitignored and must never be a
# node widget - ComfyUI writes widget values into saved workflows and into
# the PNG metadata of every image the graph produces.
# Root URL of your OpenAI-compatible chat endpoint (without /v1).
# Examples: http://127.0.0.1:4000 or https://your-proxy.example.com
KOTODAMA_BASE_URL=
KOTODAMA_API_KEY=

# Optional
# KOTODAMA_TIMEOUT=120
# Set at least one model ID if /v1/models is unavailable.
# KOTODAMA_FALLBACK_MODELS=your-model-id
